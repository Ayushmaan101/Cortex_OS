# Copy to backend/.env and fill in real values. Never commit .env.

# Supabase project (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-key

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key

# Resend, for digest emails (https://resend.com/api-keys)
RESEND_API_KEY=your-resend-api-key
DIGEST_EMAIL=you@example.com
DIGEST_FROM=CortexOS <onboarding@resend.dev>

# Optional: frontend URL used in links inside digest emails (default http://localhost:3000)
# CORTEX_URL=http://localhost:3000
